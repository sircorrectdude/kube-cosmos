# Kopieren nach backend/.env und ausfüllen. backend/.env wird beim Start automatisch gelesen
# und gehört NICHT in Git (enthält den API-Schlüssel).

# --- Sprachmodell: Google Gemini (kostenloses Kontingent) über den OpenAI-kompatiblen Endpunkt ---
# Schlüssel: https://aistudio.google.com/apikey
# Hinweis: Im kostenlosen Kontingent darf Google Eingaben zur Produktverbesserung nutzen
# (hier: Fragen sowie Namespace-/Deployment-/Service-Namen und Befehlsausgaben).
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest

# --- Alternative: lokal mit Ollama (kein Schlüssel nötig) ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen2.5-coder:7b

# --- Optional ---
# PROMETHEUS_URL=http://127.0.0.1:9090
